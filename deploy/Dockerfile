# The colca image. Build context is the repository root:
#
#   make docker
#
# or, with a bundle generated by `make bundle`:
#
#   docker build -f deploy/Dockerfile --build-context contracts-bundle=build/bundle .
#
# Both base images are public and pull anonymously.
FROM golang:1.25.13-alpine@sha256:1e0126852075c9c60731c8ba49088448b91f63e2aed97ca9d1a9791622a05946 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Every binary lives in one image. colcad runs a node; the others run beside
# it, never inside it, so that what they talk to stays out of the node core and
# off the message path:
#   colca-grantsync     carries grants between Keycloak and the tree
#   colca-historian     follows the metrics stream into TimescaleDB
#   colca-machine       the demo machine simulator
#   colca-service       publishes a service's details for a sidecar deployment
#   colca-keygen        key setup inside a container
#   colca-healthcheck   container health probe
#   colca-volume-init   prepares volume ownership before the node starts
RUN CGO_ENABLED=0 go build -trimpath -o /out/colcad ./cmd/colcad \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-grantsync ./cmd/colca-grantsync \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-historian ./cmd/colca-historian \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-machine ./cmd/colca-machine \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-keygen ./cmd/colca-keygen \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-healthcheck ./cmd/colca-healthcheck \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-service ./cmd/colca-service \
 && CGO_ENABLED=0 go build -trimpath -o /out/colca-volume-init ./cmd/colca-volume-init \
 && install -d -m 0750 -o 65532 -g 65532 /runtime/data /runtime/secrets /runtime/keys

# Pinned by digest, not by tag: distroless publishes no semver tags for
# static-debian12 — only latest/nonroot/debug — and hadolint rejects both an
# untagged base (DL3006) and :latest (DL3007). USER below applies distroless's
# standard non-root numeric identity without depending on a mutable tag.
FROM gcr.io/distroless/static-debian12@sha256:6447365a6337c3732f412d1b74357b30a633831955b2bc45552b0086be907687
COPY --from=build /out/ /usr/local/bin/
COPY --from=build --chown=65532:65532 /runtime/ /
# The contracts bundle generated from the same commit. colcad loads it from
# this path unless its config names another bundle. contracts-bundle is a named
# build context, not a stage.
# hadolint ignore=DL3022
COPY --from=contracts-bundle contracts-bundle.json /etc/colca/contracts-bundle.json
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/colcad"]
