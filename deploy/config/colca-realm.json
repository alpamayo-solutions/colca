{
  "realm": "colca",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "colca-grants",
      "description": "The groups a human belongs to, as ids in the groups claim. Grants themselves live in _Group definitions in the tree (definition-stream design §8), so Keycloak carries membership and nothing else.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "colca_groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "colca-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "colca",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "colca",
      "name": "Colca (human access)",
      "protocol": "openid-connect",
      "publicClient": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "colca-grants"
      ],
      "optionalClientScopes": []
    }
  ],
  "groups": [
    {
      "name": "01HGRP-SITE1-OPERATORS"
    },
    {
      "name": "01HGRP-ADMINS"
    }
  ],
  "users": [
    {
      "username": "anna",
      "enabled": true,
      "email": "anna@colca.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "anna-demo-password",
          "temporary": false
        }
      ],
      "groups": [
        "/01HGRP-SITE1-OPERATORS"
      ],
      "firstName": "Anna",
      "lastName": "Colca",
      "requiredActions": []
    },
    {
      "username": "boss",
      "enabled": true,
      "email": "boss@colca.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "boss-demo-password",
          "temporary": false
        }
      ],
      "groups": [
        "/01HGRP-ADMINS"
      ],
      "firstName": "Boss",
      "lastName": "Colca",
      "requiredActions": []
    },
    {
      "username": "nobody",
      "enabled": true,
      "email": "nobody@colca.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "nobody-demo-password",
          "temporary": false
        }
      ],
      "groups": [],
      "firstName": "Nobody",
      "lastName": "Colca",
      "requiredActions": []
    }
  ]
}
