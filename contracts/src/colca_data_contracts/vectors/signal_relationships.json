      "valid": false,
      "ends": {
        "pv": {
          "data_type": "float",
          "relationships": []
        },
        "a": {
          "data_type": "float",
          "relationships": [
            [
              "actual",
              "pv"
            ]
          ]
        },
        "b": {
          "data_type": "float",
          "relationships": [
            [
              "actual",
